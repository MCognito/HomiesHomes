{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "property": {
      "$id": "#property",
      "title": "Property",
      "description": "Data for creating a new property listing",
      "type": "object",
      "properties": {
        "title": {
          "description": "Property title",
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9\\s.,!?'\"-]+$"
        },
        "description": {
          "description": "Detailed description of the property",
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "price": {
          "description": "Property price",
          "type": "number",
          "minimum": 1,
          "maximum": 100000000
        },
        "location": {
          "description": "Property location",
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "bedrooms": {
          "description": "Number of bedrooms",
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "bathrooms": {
          "description": "Number of bathrooms",
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "property_type": {
          "description": "Type of property",
          "type": "string",
          "enum": [
            "house",
            "apartment",
            "condo",
            "townhouse",
            "land",
            "Apartment",
            "Terraced",
            "Cottage",
            "Villa",
            "Penthouse"
          ]
        },
        "image_url": {
          "description": "URL of property image",
          "type": "string",
          "default": "prop1.jpg"
        },
        "agent_id": {
          "description": "ID of the agent who owns this property",
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "title",
        "description",
        "price",
        "location",
        "bedrooms",
        "bathrooms",
        "property_type"
      ],
      "additionalProperties": false
    },

    "propertyUpdate": {
      "$id": "#propertyUpdate",
      "title": "Property Update",
      "description": "Data for updating an existing property",
      "type": "object",
      "properties": {
        "title": {
          "description": "Property title",
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9\\s.,!?'\"-]+$"
        },
        "description": {
          "description": "Detailed description of the property",
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "price": {
          "description": "Property price",
          "type": "number",
          "minimum": 1,
          "maximum": 100000000
        },
        "location": {
          "description": "Property location",
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "bedrooms": {
          "description": "Number of bedrooms",
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "bathrooms": {
          "description": "Number of bathrooms",
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "property_type": {
          "description": "Type of property",
          "type": "string",
          "enum": [
            "house",
            "apartment",
            "condo",
            "townhouse",
            "land",
            "Apartment",
            "Terraced",
            "Cottage",
            "Villa",
            "Penthouse"
          ]
        },
        "image_url": {
          "description": "URL of property image",
          "type": "string",
          "default": "prop1.jpg"
        },
        "agent_id": {
          "description": "ID of the agent who owns this property",
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "title",
        "description",
        "price",
        "location",
        "bedrooms",
        "bathrooms",
        "property_type"
      ],
      "additionalProperties": false
    },

    "propertyResponse": {
      "$id": "#propertyResponse",
      "title": "Property Response",
      "description": "Response for successful property creation or update",
      "type": "object",
      "properties": {
        "message": {
          "description": "Success message",
          "type": "string"
        },
        "property_id": {
          "description": "ID of the created property",
          "type": "integer"
        },
        "_links": {
          "description": "HATEOAS links",
          "type": "object"
        }
      }
    }
  }
}
