{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "booking": {
      "$id": "#booking",
      "title": "Booking",
      "description": "Data for creating a new property booking",
      "type": "object",
      "properties": {
        "property_id": {
          "description": "ID of the property being booked",
          "type": "integer",
          "minimum": 1
        },
        "scheduled_date": {
          "description": "Date for the booking",
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "scheduled_time": {
          "description": "Time for the booking",
          "type": "string",
          "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$"
        }
      },
      "required": ["property_id", "scheduled_date", "scheduled_time"],
      "additionalProperties": false
    },

    "bookingUpdate": {
      "$id": "#bookingUpdate",
      "title": "Booking Update",
      "description": "Data for updating an existing booking",
      "type": "object",
      "properties": {
        "scheduled_date": {
          "description": "Date for the booking",
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "scheduled_time": {
          "description": "Time for the booking",
          "type": "string",
          "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$"
        },
        "booking_status": {
          "description": "Status of the booking",
          "type": "string",
          "enum": ["pending", "confirmed", "cancelled", "attended"]
        }
      },
      "additionalProperties": false
    },

    "bookingStatusUpdate": {
      "$id": "#bookingStatusUpdate",
      "title": "Booking Status Update",
      "description": "Data for updating a booking status",
      "type": "object",
      "properties": {
        "status": {
          "description": "New status for the booking",
          "type": "string",
          "enum": ["pending", "confirmed", "cancelled", "attended"]
        }
      },
      "required": ["status"],
      "additionalProperties": false
    },

    "bookingResponse": {
      "$id": "#bookingResponse",
      "title": "Booking Response",
      "description": "Response for successful booking creation or update",
      "type": "object",
      "properties": {
        "message": {
          "description": "Success message",
          "type": "string"
        },
        "booking_id": {
          "description": "ID of the created booking",
          "type": "integer"
        },
        "success": {
          "description": "Boolean indicating success",
          "type": "boolean"
        },
        "_links": {
          "description": "HATEOAS links",
          "type": "object"
        }
      }
    }
  }
}
